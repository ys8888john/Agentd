# agentd 配置示例。复制成 .env 后按需修改（.env 已被 .gitignore 忽略）。
#
# 优先级：代码默认值 < .env < 真实环境变量
# .env 只补缺、不覆盖真实环境变量——CI 里被误提交的 .env 不会悄悄改掉行为。

# 模型后端：ollama | openai_compat | mimo | zhipu | fake | script（回放脚本，端到端验证用，不依赖模型）
AGENTD_LLM_BACKEND=ollama

# ---- 小米 MiMo 开放平台（backend=mimo 时用；OpenAI 兼容：/v1/chat/completions + /v1/models）----
# Key 在 https://platform.xiaomimimo.com 控制台 → API Keys 创建（按量付费是 sk- 开头）
# AGENTD_MIMO_API_KEY=sk-xxxxxxxx
# 官方也认 MIMO_API_KEY 这个名字，但仅限真实环境变量 —— .env 里必须用上面这条
# 模型名。默认 mimo-v2.5-pro；也可以设 auto（去 /v1/models 列出后按 mimo 挑）
# AGENTD_MIMO_MODEL=mimo-v2.5-pro
# 端点不用改，除非用 Token Plan（BASE_URL 和 Key 都要换成 tp- 专属那套）
# AGENTD_MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ---- 智谱 BigModel 开放平台（backend=zhipu 时用；OpenAI 兼容：/api/paas/v4）----
# Key 在 https://bigmodel.cn 控制台 → API Keys 创建，完整格式是「id.secret」两段，
# 只在创建时完整展示一次 —— 平台缩略显示的「xxxx...yyyy」不是完整 Key。
# AGENTD_ZHIPU_API_KEY=xxxxxxxx.aaaaaaaaaaaaaaaaaaaaaaaa
# 模型名。默认 glm-4.5-air（通用对话档）；视觉用 glm-4.6v，强推理可换 glm-4.6
# AGENTD_ZHIPU_MODEL=glm-4.5-air
# 端点不用改（除非切换到其它区域）
# AGENTD_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Ollama 地址。WSL2 里跑 Ollama、Windows 访问：
# 需要 %USERPROFILE%\.wslconfig 里开 networkingMode=mirrored，然后 localhost 直连
AGENTD_OLLAMA_HOST=http://localhost:11434

# 模型名。默认 auto = 启动时去 /api/tags 问本机有什么模型再挑一个。
# 想固定就写死，例如 AGENTD_OLLAMA_MODEL=qwen3.5:9b-text
AGENTD_OLLAMA_MODEL=auto

# auto 模式下的偏好顺序（子串匹配，先命中先选）
AGENTD_OLLAMA_PREFER=qwen3.5,qwen3,glm,deepseek,llama3,llama,gemma,mistral

# 让模型输出思考过程再回答（Ollama 原生 think 参数）
AGENTD_OLLAMA_THINK=false

# 系统提示词，留空表示不设置
# AGENTD_SYSTEM_PROMPT=你是一个简洁的助手。

# ---- token 预算 ----
# 上下文预算（喂给模型的历史消息上限；system prompt 与 tools schema 另算）。
# 0 = 不限（默认）。**必须按你实际用的模型窗口填**：
#   本地 qwen3.5:9b 常见 num_ctx=4096~40960，而云端 GLM/MiMo 是 128k，
#   两者差三倍以上 —— 写死一个全局值，必然一边严重浪费、一边静默溢出。
#   溢出的症状不是报错，是模型"莫名其妙变笨"（把开头的内容忘了）。
# 超预算时从**最早的**历史开始丢（保留最近进展和你当前这一问），
# 并在回答前给客户端发一行 [提示] 告诉你裁了几条。
# AGENTD_MAX_CONTEXT_TOKENS=8192

# 单次回答的最大输出 token。0 = 交给后端默认（大多数是它的最大输出）。
# 走 Ollama 时是 options.num_predict，走 OpenAI 兼容端点是 max_tokens。
# 想让回答短就设小（比如 512）；不用动 num_ctx —— 那是输入窗口，
# 设小了 Ollama 会真的截断输入，症状跟"模型变笨"一模一样，极难自查。
# AGENTD_MAX_OUTPUT_TOKENS=1024

# 占到上面那个预算的百分之几就自动压缩（把较早的对话压成摘要再缩小上下文窗口）。
# 0 = 关掉自动压缩，只在真的溢出时才裁剪。默认 80。
# 为什么要留出这 20%：压缩本身要额外调一次模型，预算见底时做这事会把最后一点
# 空间也花掉；剩下的份额还要留给"本轮提问 + 工具往返 + 模型回答"。
# 压出来的摘要会挂在 system prompt 里替被移走的部分说话；原始对话一条不删，
# 历史回放依旧完整。模型压不出来（小模型常见）时不做任何移动 ——
# 宁可多占一点预算，也不删没有备份的东西。
AGENTD_COMPACT_RATIO=80

# ---- 跨会话记忆 ----
# 累积多少条消息就压一次摘要 + 抽一次长期事实。0 = 完全关掉（连读历史摘要也不做，
# 每个新会话都是干净的第一次见面）。默认 20。
# 注意这条依赖模型**能**按格式输出"摘要/事实"，本机很小的模型（1B 以下）可能压不干净 ——
# 那时宁设 0，也别让半成品摘要混进 system prompt。
AGENTD_SUMMARY_EVERY=20

# 新会话的 system prompt 里放几条历史会话摘要。默认 6。
AGENTD_SUMMARY_RECALL=6

# 长期事实写在哪里（Markdown，**可以直接手改**）。默认 ~/.agentd/memory.md。
# 这份文件每轮都进 system prompt，只该留跨会话仍然成立的事实。
# AGENTD_MEMORY_FILE=

# 会话存储：sqlite（默认，持久化）| memory（重启即丢）
AGENTD_STORE=sqlite

# SQLite 会话库位置。默认 ~/.agentd/sessions.db
# AGENTD_DB_PATH=C:/Users/你/.agentd/sessions.db

# ---- 原生工具（进程内 read_file / glob / grep / write_file / edit / run_command
#                   + 联网的 web_search / web_fetch）----
# 启用范围：native（默认，全开）| read_only（只留读/搜三个，联网工具也不给）| off（全关，退回纯聊天）
AGENTD_TOOLS=native

# 是否允许工具访问会话 cwd **之外**的路径。默认 false。
# 放开意味着 agent 能读 ~/.ssh、系统配置……请确认你知道自己在做什么。
AGENTD_TOOLS_ALLOW_OUTSIDE=false

# run_command 的默认超时（秒）
AGENTD_TOOLS_TIMEOUT=30

# 审批策略：native（默认，只拦原生写/执行类 + MCP 自报 destructive 的工具）
#           | all（非只读全拦）| none（全放行，仅无人值守场景）
# 注意：只读动作（read/search/fetch）在任何策略下都不弹 —— 含联网的 web_search/web_fetch。
AGENTD_TOOLS_APPROVE=native

# web_search 用的搜索后端。默认 Bing 且**实测只有它可用**（DuckDuckGo/SearXNG 被隧道
# 挡、Baidu 回反爬页）。换成别的地址时，返回的 HTML 结构必须跟 Bing 一致（b_algo 块），
# 否则解析不出结果。调用时实时读取，改了不用重启。
# AGENTD_SEARCH_ENDPOINT=https://cn.bing.com/search
