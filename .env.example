# agentd 配置示例。复制成 .env 后按需修改（.env 已被 .gitignore 忽略）。
#
# 优先级：代码默认值 < .env < 真实环境变量
# .env 只补缺、不覆盖真实环境变量——CI 里被误提交的 .env 不会悄悄改掉行为。

# 模型后端：ollama | openai_compat | fake
AGENTD_LLM_BACKEND=ollama

# Ollama 地址。WSL2 里跑 Ollama、Windows 访问：
# 需要 %USERPROFILE%\.wslconfig 里开 networkingMode=mirrored，然后 localhost 直连
AGENTD_OLLAMA_HOST=http://localhost:11434

# 模型名。默认 auto = 启动时去 /api/tags 问本机有什么模型再挑一个。
# 想固定就写死，例如 AGENTD_OLLAMA_MODEL=qwen3.5:9b-text
AGENTD_OLLAMA_MODEL=auto

# auto 模式下的偏好顺序（子串匹配，先命中先选）
AGENTD_OLLAMA_PREFER=qwen3.5,qwen3,glm,deepseek,llama3,llama,gemma,mistral

# 让模型输出思考过程再回答（Ollama 原生 think 参数）
AGENTD_OLLAMA_THINK=false

# 系统提示词，留空表示不设置
# AGENTD_SYSTEM_PROMPT=你是一个简洁的助手。

# 会话存储：sqlite（默认，持久化）| memory（重启即丢）
AGENTD_STORE=sqlite

# SQLite 会话库位置。默认 ~/.agentd/sessions.db
# AGENTD_DB_PATH=C:/Users/你/.agentd/sessions.db

# ---- 原生工具（进程内 read_file / glob / grep / write_file / edit / run_command）----
# 启用范围：native（默认，全开）| read_only（只留读/搜三个）| off（全关，退回纯聊天）
AGENTD_TOOLS=native

# 是否允许工具访问会话 cwd **之外**的路径。默认 false。
# 放开意味着 agent 能读 ~/.ssh、系统配置……请确认你知道自己在做什么。
AGENTD_TOOLS_ALLOW_OUTSIDE=false

# run_command 的默认超时（秒）
AGENTD_TOOLS_TIMEOUT=30

# 审批策略：native（默认，只拦原生写/执行类 + MCP 自报 destructive 的工具）
#           | all（非只读全拦）| none（全放行，仅无人值守场景）
AGENTD_TOOLS_APPROVE=native
